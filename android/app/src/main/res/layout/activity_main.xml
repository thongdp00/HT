<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Core Video Surface (ExoPlayer) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Music Channel Visualizer Overlay -->
    <FrameLayout
        android:id="@+id/musicVisualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivVinyl"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/ic_launcher"
                android:background="@drawable/bg_pill"
                android:padding="20dp" />

            <TextView
                android:id="@+id/tvMusicTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="On Music HD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/amber_500"
                android:textSize="14sp"
                android:text="HT TV Music Stream" />
        </LinearLayout>
    </FrameLayout>

    <!-- Channel Info OSD (Bottom Overlay) -->
    <LinearLayout
        android:id="@+id/channelInfoOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D90A0A0C"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOsdNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/amber_500"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="01" />

        <ImageView
            android:id="@+id/ivOsdLogo"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOsdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="VTV1 HD" />

            <TextView
                android:id="@+id/tvOsdGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                tools:text="Nhóm: Kênh VTV" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="TRỰC TIẾP"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Remote Digits OSD (Top Right Overlay) -->
    <TextView
        android:id="@+id/tvDigitsOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="#D9000000"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/amber_500"
        android:textSize="44sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="105" />

    <!-- Loading Spinner & Status -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="#B3000000"
        android:padding="24dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/amber_500" />

        <TextView
            android:id="@+id/tvLoadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/loading_stream"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Channel Drawer / Sidebar (Left Overlay) -->
    <LinearLayout
        android:id="@+id/drawerLayout"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:padding="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- App Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HT TV"
                android:textColor="@color/amber_500"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalChannels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                tools:text="120 kênh" />
        </LinearLayout>

        <!-- Categories List (Horizontal) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal" />

        <!-- Channels List (Vertical) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

</FrameLayout>
